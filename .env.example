DATABASE_URL=postgres://lab:lab@localhost:5434/research_lab
ARTIFACT_ROOT=./data/artifacts

AIHUB_BASE_URL=http://192.168.10.114/v1
AIHUB_SERVICE_NAME=research-lab

MODEL_FRONTIER=best              # hub alias (openai/gpt-5.6-sol; needs valid key on hub)
MODEL_STRONG_LOCAL=default       # hub alias (local model; json_schema + tools verified)
MODEL_FAST_LOCAL=cheapest        # hub alias (deepseek; json_object mode only)
PLANNER_TIER=strong_local        # TEMPORARY (phase-3-plan D3): set to frontier once hub keys are fixed
# SEARXNG_BASE_URL=http://<host>:8888   # D4: web_search registers only when set (self-hosted SearXNG)
RESEARCHER_MAX_TOOL_CALLS=8

WORKER_CONCURRENCY=2
GPU_CONCURRENCY_STRONG_LOCAL=2
TASK_CLAIM_TIMEOUT_S=900
POLL_INTERVAL_MS=500
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_MAX_EVAL_CYCLES=3
API_PORT=8787
STALE_SWEEP_INTERVAL_MS=30000
