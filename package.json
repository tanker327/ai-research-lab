{
  "name": "ai-research-lab",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "lint:imports": "bun scripts/import-lint.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run lint && bun run lint:imports && bun run typecheck && bun run typecheck:web && bun run test && bun run test:hooks",
    "migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "dev:worker": "bun --watch apps/worker/src/main.ts",
    "test:hooks": "bun test ./.claude/hooks/hooks.test.ts",
    "gate:p0": "bash scripts/gates/p0.sh",
    "gate:p1": "bun scripts/gates/p1.ts",
    "dev:web": "bun --cwd apps/web run dev",
    "typecheck:web": "tsc --noEmit -p apps/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
